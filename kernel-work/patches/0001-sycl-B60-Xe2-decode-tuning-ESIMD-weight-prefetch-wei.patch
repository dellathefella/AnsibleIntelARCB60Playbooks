 option(GGML_SYCL_DNN                        "ggml: enable oneDNN in the SYCL backend"         ON)
+option(GGML_SYCL_BMG_STREAM_W               "ggml: stream weight loads past L1/L2 caches (Xe2/BMG decode)" OFF)
+option(GGML_SYCL_BMG_PREFETCH               "ggml: prefetch next weight block in ESIMD matvec (Xe2/BMG decode)" OFF)
