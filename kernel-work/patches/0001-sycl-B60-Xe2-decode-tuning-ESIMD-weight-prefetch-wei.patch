 ggml/src/ggml-sycl/CMakeLists.txt | 10 ++++
 ggml/src/ggml-sycl/dmmv.cpp       | 22 ++++++-
 ggml/src/ggml-sycl/esimd.hpp      | 96 ++++++++++++++++++++++---------
 4 files changed, 102 insertions(+), 28 deletions(-)

