-        simd<uint8_t, 16> scales_a = block_load<uint8_t, 16>(pa.scales + bia * (QK_K / 16));
+        simd<uint8_t, 16> scales_a = w_load<uint8_t, 16>(pa.scales + bia * (QK_K / 16));
