{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
{% for tname, t in tracks.items() %}
    "{{ t.opencode_provider_id }}": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "{{ t.opencode_provider_name }}",
      "options": {
        "baseURL": "http://{{ api_host }}:{{ t.api_port }}/v1"
      },
      "models": {
        "{{ t.opencode_model_id }}": {
          "name": "{{ t.opencode_provider_name }}",
          "reasoning": {{ opencode_reasoning | tojson }},
          "limit": {
            "context": {{ t.opencode_context_limit | int }},
            "output": {{ opencode_output_limit | int }}
          }
        }
      }
    }{{ "," if not loop.last else "" }}
{% endfor %}
  },
  "model": "{{ tracks[active_track].opencode_provider_id }}/{{ tracks[active_track].opencode_model_id }}"
}
