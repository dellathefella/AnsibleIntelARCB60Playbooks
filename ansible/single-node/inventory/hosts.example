# =============================================================================
# hosts.example — SINGLE-NODE inventory template
#
# Copy to `hosts` and edit. Connection vars are inline per host (no
# host_vars/). Capability groups: [sycl] for ReBAR-enabled B60 hosts,
# [legacy] for no-ReBAR rigs (no play targets it).
# =============================================================================

[sycl]
halo1 ansible_host=10.0.1.67 ansible_connection=ssh ansible_user=jdella

[xpu]
halo1 ansible_host=10.0.1.67 ansible_connection=ssh ansible_user=jdella

[legacy]
b60 ansible_connection=local ansible_user=jdella

[aiservers:children]
sycl
xpu
