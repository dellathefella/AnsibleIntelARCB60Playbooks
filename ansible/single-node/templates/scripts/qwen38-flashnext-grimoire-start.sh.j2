#!/bin/bash
# =============================================================================
# {{ track_stem }}-start.sh — Qwen3.8-Flash-Next (NVFP4) via GRIMOIRE
# (native C++/SYCL/Level-Zero, github.com/doopeworld/GRIMOIRE) on Arc Pro B60.
#
# Generated by {{ track_stem }}-podman.yml. Built from source (AOT g31+g21).
#
# Image:     {{ docker_image }} (oneAPI 2026.1 — GRIMOIRE's pinned icpx)
# Container: {{ docker_container_name }}
# Port:      {{ host_port }} (server mode)
# Model:     {{ _repo_dir }} (mounted at {{ _container_repo_dir }})
# Backend:   SYCL/Level-Zero, intel_gpu_bmg_g21 AOT (requires Resizable BAR)
# Device:    ONEAPI_DEVICE_SELECTOR=level_zero:{{ level_zero_device }}
# Tiering:   {{ expert_vram_per_layer }} experts/layer VRAM + ~53 GiB pinned RAM,
#            hits file {{ hits_file }} (warms VRAM placement across runs)
# Ctx:       {{ ctx }}
#
# usage: {{ track_stem }}-start.sh [server|bench|logs|stop]
# =============================================================================
set -euo pipefail

CONTAINER="{{ docker_container_name }}"
PORT="{{ host_port }}"
IMAGE="{{ docker_image }}"
GRIMOIRE_SRC="{{ grimoire_src }}"
MODELS_DIR="{{ _models_dir }}"
CONTAINER_MODELS="{{ _container_models_dir }}"
MODEL="{{ _container_repo_dir }}"
L0_DEV="{{ level_zero_device }}"
VRAM_PER_LAYER="{{ expert_vram_per_layer }}"
HITS="{{ hits_file }}"
CTX="{{ ctx }}"

_env_args=(
  -e ONEAPI_DEVICE_SELECTOR=level_zero:${L0_DEV}
  -e GRIMOIRE_EXPERT_VRAM_PER_LAYER=${VRAM_PER_LAYER}
  -e GRIMOIRE_EXPERT_HITS=${HITS}
)
_mounts=(
  -v "${GRIMOIRE_SRC}:/g"
  -v "${MODELS_DIR}:${CONTAINER_MODELS}"
)
_sycl='source /opt/intel/oneapi/setvars.sh --force >/dev/null 2>&1; export LD_LIBRARY_PATH=/g/bin:$LD_LIBRARY_PATH;'

start_server() {
  podman rm -f "$CONTAINER" >/dev/null 2>&1 || true
  echo "Starting GRIMOIRE server: $CONTAINER (level_zero:$L0_DEV, $VRAM_PER_LAYER experts/layer, ctx $CTX)"
  podman run -d --name "$CONTAINER" --init --stop-timeout 300 \
    --device /dev/dri --security-opt label=disable \
    "${_mounts[@]}" "${_env_args[@]}" \
    -p ${PORT}:${PORT} -w /g \
    --entrypoint /bin/bash "$IMAGE" \
    -c "${_sycl} exec ./bin/grimoire-server --model ${MODEL} --proj bf16 --ctx ${CTX} --port ${PORT}"
  echo "Load takes ~5 min. Watch: podman logs -f $CONTAINER"
  echo "API: http://$(hostname -I | awk '{print $1}'):${PORT}/v1"
}

bench() {
  # CLI benchmark (no server): 256 generated tokens from a fixed prompt.
  local prompt="${1:-To Sherlock Holmes she is always the woman. I have seldom heard him mention her under any other name. In his eyes she eclipses and predominates the whole of her sex. How does Holmes regard Irene Adler?}"
  podman run --rm --device /dev/dri --security-opt label=disable \
    "${_mounts[@]}" "${_env_args[@]}" -w /g \
    --entrypoint /bin/bash "$IMAGE" \
    -c "${_sycl} ./bin/grimoire --model ${MODEL} --proj bf16 --ctx ${CTX} -p \"${prompt}\" -n 256"
}

case "${1:-server}" in
  server) start_server ;;
  bench)  shift; bench "$@" ;;
  logs)   podman logs -f "$CONTAINER" ;;
  stop)   podman stop -t 300 "$CONTAINER" ;;
  *)      echo "usage: $0 [server|bench [PROMPT]|logs|stop]"; exit 2 ;;
esac
