#!/bin/bash
# =============================================================================
# {{ track_stem }}-start.sh — Qwen3.8-27B (AWQ INT4) via vLLM XPU
# (official vllm/vllm-openai-xpu image) on the Arc B60.
#
# Generated by {{ track_stem }}-podman.yml. Image is PULLED (never built).
#
# Image:     {{ docker_image }}
# Container: {{ docker_container_name }}
# Port:      {{ host_port }}
# Model:     {{ _repo_dir }}  (mounted read-only at {{ _container_repo_dir }})
# Backend:   XPU / Level-Zero (requires Resizable BAR)
# Quant:     AWQ W4A16, text-only (18.2 GiB weights, ~1.3 GiB fp8 paged KV)
# Ctx:     {{ ctx }} (vLLM-computed ceiling on the 24 GB B60)
# =============================================================================
set -euo pipefail

# --- config ---
CONTAINER="{{ docker_container_name }}"
PORT="{{ host_port }}"
REPO_DIR="{{ _repo_dir }}"
CONTAINER_REPO="{{ _container_repo_dir }}"
IMAGE="{{ docker_image }}"
CTX="{{ ctx }}"
GPU_MEM_UTIL="{{ gpu_mem_util }}"
KV_DTYPE="{{ kv_cache_dtype }}"
SERVED_MODEL="{{ served_model_name }}"
MAX_NUM_SEQS="{{ max_num_seqs }}"
SPEC_CONFIG='{"method":"{{ spec_method }}","num_speculative_tokens":{{ spec_num_tokens }}}'

# --- helper functions ---
start_container() {
  echo "Starting vLLM XPU container: $CONTAINER"
  # NOTE: the image entrypoint is already `vllm serve` — model is positional.
  podman run -d --name "$CONTAINER" \
    --rm \
    --device /dev/dri \
    --security-opt label=disable \
    --ipc=host \
    -v "${REPO_DIR}:${CONTAINER_REPO}:ro" \
    -e ZE_AFFINITY_MASK=0 \
    -e HF_HUB_OFFLINE=1 \
    -e VLLM_XPU_VISIBLE_DEVICES=0 \
    -p ${PORT}:${PORT} \
    "$IMAGE" \
    "${CONTAINER_REPO}" \
      --served-model-name "$SERVED_MODEL" \
      --max-model-len "$CTX" \
      --gpu-memory-utilization "$GPU_MEM_UTIL" \
      --kv-cache-dtype "$KV_DTYPE" \
      --dtype float16 \
      --max-num-seqs "$MAX_NUM_SEQS" \
      --speculative-config "$SPEC_CONFIG" \
      --host 0.0.0.0 --port "$PORT"
}

stop_container() {
  podman stop "$CONTAINER" 2>/dev/null || true
  podman rm -f "$CONTAINER" 2>/dev/null || true
}

# --- check image is present (pull if missing) ---
if ! podman image exists "$IMAGE"; then
  echo "Image not found locally, pulling: $IMAGE"
  podman pull "$IMAGE"
fi

# --- check model repo exists ---
if [ ! -f "$REPO_DIR/config.json" ]; then
  echo "ERROR: model repo not found: $REPO_DIR" >&2
  echo "       re-run the {{ track_stem }}-podman playbook, or:" >&2
  echo "       hf download {{ hf_repo }} --local-dir $REPO_DIR" >&2
  exit 1
fi

# --- handle existing container ---
CONTAINER_LIST=$(podman ps -a --format '{% raw %}{{ .Names }}{% endraw %}')
if echo "$CONTAINER_LIST" | grep -q "^${CONTAINER}$"; then
  echo "Container ${CONTAINER} exists - stopping and removing..."
  stop_container
fi

# --- start ---
start_container

# --- wait for health ---
echo "Waiting for vLLM health check (AWQ weight load + warmup)..."
for i in $(seq 1 180); do
  if curl -sf "http://localhost:${PORT}/health" >/dev/null 2>&1; then
    echo "=== vLLM is ready ({{ track_stem }}, XPU) ==="
    echo "Container: $CONTAINER"
    echo "Image:     $IMAGE"
    echo "Port:      $PORT"
    echo "Model:     $REPO_DIR"
    echo "API:       http://localhost:${PORT}/v1"
    exit 0
  fi
  sleep 5
done

echo "WARNING: vLLM did not become healthy within 15 minutes" >&2
echo "         check: podman logs $CONTAINER" >&2
exit 1
