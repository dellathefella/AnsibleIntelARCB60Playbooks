#!/bin/bash
# =============================================================================
# {{ track_stem }}-start.sh — Qwen3.8-Flash-Next via Strata (SYCL port)
# on 1-2x Arc Pro B60 (fork dellathefella/Strata, branch {{ strata_branch }}).
#
# Generated by {{ track_stem }}-podman.yml.
#
# Image:     {{ docker_image }}
# Source:    {{ strata_src }} (built in-container; binary build/strata)
# Pack:      {{ pack_dir }}          Native shard: {{ native_shard1 }}
# PLE:       {{ ple_gguf }}          Profile: {{ expert_profile }}
# MTP (split serve only): {{ mtp_rt_dir }}
# Backend:   SYCL/Level-Zero eager windows (requires Resizable BAR)
# Devices:   ONEAPI_DEVICE_SELECTOR=level_zero:{{ level_zero_devices }}
# Flags:     --spec {{ spec }} --prefill {{ prefill_chunk }} --max-context {{ max_context }}
#            --pcie-mode {{ pcie_mode }} --pcie-frac {{ pcie_frac }}
#            (pcie-mode dma: the kernel/direct modes make the GPU read the
#             119 GiB host arena — that faults on this driver)
#
# usage: {{ track_stem }}-start.sh [bench|bench-split|serve|logs|stop]
#   bench        one card (level_zero:1), 32-token decode from prompt-toks.txt
#   bench-split  2-GPU layer split in serve mode (needs the MTP rt dir)
#   serve        interactive serve on the split (pipe GEN lines to stdin)
# =============================================================================
set -euo pipefail

IMAGE="{{ docker_image }}"
SRC="{{ strata_src }}"
CONTAINER="{{ docker_container_name }}"
USER_HOME="{{ _user_home }}"
PACK="{{ pack_dir }}"
SHARD1="{{ native_shard1 }}"
PLE="{{ ple_gguf }}"
PROFILE="{{ expert_profile }}"
MTP_RT="{{ mtp_rt_dir }}"
L0_DEVICES="{{ level_zero_devices }}"
SPLIT_DEVICE="{{ split_device }}"
LAYER_SPLIT="{{ layer_split }}"
SPEC="{{ spec }}"
PREFILL="{{ prefill_chunk }}"
CTX="{{ max_context }}"

_common=(
  --pack /host/pack-q8_0
  --native /data/models/Q8_0/Qwen3.8-Flash-Next-Q8_0-00001-of-00006.gguf
  --ple-gguf /host/ple_key.gguf
  --max-context ${CTX}
  --expert-profile /src/data/expert-profile.bin
  --expert-cache auto
  --pcie-frac {{ pcie_frac }} --pcie-mode {{ pcie_mode }}
  --spec ${SPEC} --prefill ${PREFILL}
)
_podman_common=(
  --device /dev/dri --security-opt label=disable
  -v ${SRC}:/src -v /data:/data -v ${USER_HOME}:/host
  -v ${USER_HOME}/neocache:/root/.cache
  -w /src
)

bench() {
  local dev="${1:-1}" toks="${2:-/host/prompt-toks.txt}" maxnew="${3:-32}"
  podman run --rm "${_podman_common[@]}" \
    -e ONEAPI_DEVICE_SELECTOR=level_zero:${dev} \
    --entrypoint /bin/bash ${IMAGE} \
    -c "./build/strata ${_common[*]} --tokens-file ${toks} --max-new ${maxnew}"
}

_serve_cmd="./build/strata --serve --layer-split ${LAYER_SPLIT} --split-device ${SPLIT_DEVICE} \
  --mtp /host/mtp-rt --conversation-cache-mib 0 ${_common[*]}"

serve() {
  echo "Interactive split serve — paste 'GEN <max_new> <id,id,...>' lines, 'QUIT' to exit."
  podman run -i --rm "${_podman_common[@]}" \
    -e ONEAPI_DEVICE_SELECTOR=level_zero:${L0_DEVICES} \
    --entrypoint /bin/bash ${IMAGE} -c "${_serve_cmd}"
}

bench_split() {
  local toks_csv="${1:-/host/prompt-ids.txt}" maxnew="${2:-32}"
  ( echo "GEN ${maxnew} $(cat ${toks_csv/#\/host\//$USER_HOME\/} 2>/dev/null || cat ${USER_HOME}/prompt-ids.txt)"; sleep 300; echo QUIT ) \
    | podman run -i --rm "${_podman_common[@]}" \
        -e ONEAPI_DEVICE_SELECTOR=level_zero:${L0_DEVICES} \
        --entrypoint /bin/bash ${IMAGE} -c "${_serve_cmd}"
}

case "${1:-bench}" in
  bench)        shift || true; bench "$@" ;;
  bench-split)  shift || true; bench_split "$@" ;;
  serve)        serve ;;
  stop)         podman rm -f ${CONTAINER} >/dev/null 2>&1 || true ;;
  *)            echo "usage: $0 [bench [DEV [TOKS MAXNEW]]|bench-split|serve|stop]"; exit 2 ;;
esac
