#!/bin/bash
# =============================================================================
# {{ track_stem }}-start.sh — Qwen3.8-27B (IQ3_S→Q4_K tuned GGUF + MTP) via
# llama.cpp SYCL (full-intel image) on the Arc B60.
#
# Generated by {{ track_stem }}-podman.yml. Image is PULLED (never built).
#
# Image:     {{ docker_image }}
# Container: {{ docker_container_name }}
# Port:      {{ host_port }}
# Model:     {{ _models_dir }}/{{ model }}  (mounted read-only at {{ _container_models_dir }})
# Backend:   SYCL/Level-Zero (requires Resizable BAR)
# Draft:     MTP draft_n={{ spec_draft_n_max }} (measured best on halo1)
# =============================================================================
set -euo pipefail

# --- config ---
CONTAINER="{{ docker_container_name }}"
PORT="{{ host_port }}"
MODEL="{{ _models_dir }}/{{ model }}"
MODEL_DIR="{{ _models_dir }}"
CONTAINER_MODELS="{{ _container_models_dir }}"
IMAGE="{{ docker_image }}"

# --- helper functions ---
start_container() {
  echo "Starting llama.cpp SYCL container: $CONTAINER"
  podman run -d --name "$CONTAINER" \
    --rm \
    --device /dev/dri \
    --security-opt label=disable \
    -v "${MODEL_DIR}:${CONTAINER_MODELS}:ro" \
    -e UR_LOADER_USE_LEVEL_ZERO_V2=0 \
    -e ONEAPI_DEVICE_SELECTOR=level_zero:0 \
    -e ZE_AFFINITY_MASK=0 \
    -p ${PORT}:${PORT} \
    --entrypoint /app/llama-server \
    "$IMAGE" \
    {{ _llama_args | replace('\n', ' ') }}
}

stop_container() {
  podman stop "$CONTAINER" 2>/dev/null || true
  podman rm -f "$CONTAINER" 2>/dev/null || true
}

# --- check image is present (pull if missing) ---
if ! podman image exists "$IMAGE"; then
  echo "Image not found locally, pulling: $IMAGE"
  podman pull "$IMAGE"
fi

# --- check model exists ---
if [ ! -f "$MODEL" ]; then
  echo "ERROR: model not found: $MODEL" >&2
  echo "       re-run the {{ track_stem }}-podman playbook, or:" >&2
  echo "       hf download {{ hf_repo }} {{ model }} --local-dir {{ _models_dir }}" >&2
  exit 1
fi

# --- handle existing container ---
CONTAINER_LIST=$(podman ps -a --format '{% raw %}{{ .Names }}{% endraw %}')
if echo "$CONTAINER_LIST" | grep -q "^${CONTAINER}$"; then
  echo "Container ${CONTAINER} exists - stopping and removing..."
  stop_container
fi

# --- start ---
start_container

# --- wait for health ---
echo "Waiting for llama-server health check ({{ (model_size / 1073741824) | round(1) }} GB cold load)..."
for i in $(seq 1 120); do
  if curl -sf "http://localhost:${PORT}/health" >/dev/null 2>&1; then
    echo "=== llama.cpp is ready ({{ track_stem }}, SYCL) ==="
    echo "Container: $CONTAINER"
    echo "Image:     $IMAGE"
    echo "Port:      $PORT"
    echo "Model:     $MODEL"
    echo "API:       http://localhost:${PORT}/v1"
    exit 0
  fi
  sleep 5
done

echo "WARNING: llama-server did not become healthy within 10 minutes" >&2
echo "         check: podman logs $CONTAINER" >&2
exit 1
