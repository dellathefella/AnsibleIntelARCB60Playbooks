#!/bin/bash
# =============================================================================
# {{ track_stem }}-start.sh — four independent EXL3 instances, one per Arc B60.
#
# Generated by {{ track_stem }}-podman.yml. Image is PULLED (never built).
#
# Image:     {{ docker_image }}
# Containers: {{ docker_container_name }}-0 .. {{ docker_container_name }}-{{ instances - 1 }}
# Ports:     {{ base_port }} .. {{ base_port + instances - 1 }}
# Model:     {{ _repo_dir }}  (mounted read-only at {{ _container_repo_dir }})
# Backend:   XPU / Level-Zero, one engine per card (requires Resizable BAR)
# Quant:     EXL3 trellis 4.00 bpw + MTP3, fp16 compute, fp8 KV
# Ctx:       {{ ctx }} per instance
# Power:     {{ power_limit_watts }} W/card burst cap (xpu-powerlimit.service)
# =============================================================================
set -euo pipefail

# --- config ---
IMAGE="{{ docker_image }}"
REPO_DIR="{{ _repo_dir }}"
CONTAINER_REPO="{{ _container_repo_dir }}"
BASE_PORT="{{ base_port }}"
INSTANCES="{{ instances }}"
CTX="{{ ctx }}"
GMU="{{ gpu_mem_util }}"
MODEL="{{ served_model_name }}"
NAME="{{ docker_container_name }}"

# --- check image ---
if ! podman image exists "$IMAGE"; then
  echo "Image not found locally, pulling: $IMAGE"
  podman pull "$IMAGE"
fi

# --- check model repo ---
if [ ! -f "$REPO_DIR/config.json" ]; then
  echo "ERROR: model repo not found: $REPO_DIR" >&2
  echo "       re-run the {{ track_stem }}-podman playbook, or:" >&2
  echo "       hf download {{ hf_repo }} --revision {{ hf_revision }} --local-dir $REPO_DIR" >&2
  exit 1
fi

# --- start one container per card ---
for i in $(seq 0 $((INSTANCES - 1))); do
  PORT=$((BASE_PORT + i))
  CNAME="${NAME}-$i"
  podman rm -f "$CNAME" 2>/dev/null || true
  echo "Starting $CNAME on GPU $i, port $PORT"
  # setsid + restart policy: rootless podman SIGTERMs containers when the SSH
  # session's process group exits, and --rm would then delete them.
  setsid podman run -d --name "$CNAME" \
    --restart=unless-stopped \
    --device /dev/dri --security-opt label=disable --ipc=host \
    --group-add keep-groups \
    -v /dev/dri/by-path:/dev/dri/by-path:ro \
    -v "$REPO_DIR:$CONTAINER_REPO:ro" \
    -e ZE_FLAT_DEVICE_HIERARCHY=COMPOSITE \
    -p "$PORT:$PORT" \
    "$IMAGE" \
    models/qwen3.8-27b-exl3-4.00bpw \
    --gpu "$i" \
    --port "$PORT" \
    --model-path "$CONTAINER_REPO" \
    --set "vllm.gpu_memory_utilization=$GMU" \
    --set "vllm.max_model_len=$CTX" \
    --set "vllm.max_num_seqs=8"
done

# --- wait for health (EXL3 health probe = /v1/models) ---
echo "Waiting for all four endpoints..."
for i in $(seq 0 $((INSTANCES - 1))); do
  PORT=$((BASE_PORT + i))
  for attempt in $(seq 1 240); do
    if curl -sf "http://127.0.0.1:$PORT/v1/models" >/dev/null 2>&1; then
      echo "  port $PORT ready"
      break
    fi
    sleep 5
  done
done

# --- warm the decode path on each endpoint ---
echo "Warming up..."
for i in $(seq 0 $((INSTANCES - 1))); do
  PORT=$((BASE_PORT + i))
  python3 - "$PORT" "$MODEL" <<'PY' || true
import json, sys, urllib.request
port, model = sys.argv[1], sys.argv[2]
prompt = ("def helper(x):\n    return x*2+1\n\n" * 900) + "Warmup."
body = json.dumps({"model": model, "messages": [{"role": "user", "content": prompt}],
                   "max_tokens": 128, "temperature": 0}).encode()
req = urllib.request.Request(f"http://127.0.0.1:{port}/v1/chat/completions",
                             data=body, headers={"Content-Type": "application/json"})
urllib.request.urlopen(req, timeout=900).read()
PY
done

echo "=== EXL3 4x ready ==="
for i in $(seq 0 $((INSTANCES - 1))); do
  echo "  GPU $i: http://127.0.0.1:$((BASE_PORT + i))/v1"
done
