{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    {% for i in range(0, instances) %}
    "{{ opencode_provider_prefix }}-{{ i }}": {
      "name": "{{ opencode_provider_name }} (GPU {{ i }})",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://{{ ansible_host | default(inventory_hostname) }}:{{ base_port + i }}/v1",
        "apiKey": "{{ track_stem }}-local",
        "headerTimeout": 3600000,
        "chunkTimeout": 3600000,
        "timeout": false
      },
      "models": {
        "{{ opencode_model_id }}": {
          "modelID": "{{ opencode_model_id }}",
          "name": "{{ opencode_model_name }} (GPU {{ i }})",
          "limit": {
            "context": {{ opencode_context_limit }},
            "output": {{ opencode_output_limit }}
          },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "body": {
            "temperature": 0.6,
            "top_p": 0.95
          }
        }
      }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  }
}
